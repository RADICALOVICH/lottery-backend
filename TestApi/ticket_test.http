@host = http://localhost:8080
@ticketId = 1
@drawId = 1

###---------------------------------------
### REGISTER / LOGIN USER
###---------------------------------------

# @name registerUser
POST {{host}}/auth/register
Content-Type: application/json

{
  "login": "ticket_user",
  "password": "12345678"
}

###

# @name loginUser
POST {{host}}/auth/login
Content-Type: application/json

{
  "login": "ticket_user",
  "password": "12345678"
}

> {%
    client.global.set("userToken", response.body.token);
    client.log("userToken = " + client.global.get("userToken"));
%}

###---------------------------------------
### REGISTER / LOGIN ADMIN
###---------------------------------------

# @name registerAdmin
POST {{host}}/auth/register
Content-Type: application/json

{
  "login": "admin",
  "password": "admin123"
}

###

# @name loginAdmin
POST {{host}}/auth/login
Content-Type: application/json

{
  "login": "admin",
  "password": "admin123"
}

> {%
    client.global.set("adminToken", response.body.token);
    client.log("adminToken = " + client.global.get("adminToken"));
%}

###---------------------------------------
### OPTIONAL SECOND USER
###---------------------------------------

# @name registerUser2
POST {{host}}/auth/register
Content-Type: application/json

{
  "login": "ticket_user_2",
  "password": "12345678"
}

###

# @name loginUser2
POST {{host}}/auth/login
Content-Type: application/json

{
  "login": "ticket_user_2",
  "password": "12345678"
}

> {%
    client.global.set("user2Token", response.body.token);
    client.log("user2Token = " + client.global.get("user2Token"));
%}

###---------------------------------------
### CREATE DRAW
###---------------------------------------

# @name createDraw
POST {{host}}/admin/draws
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "title": "Ticket Module Test Draw",
  "endDate": "2026-04-25T18:00:00+03:00",
  "totalTickets": 5
}

> {%
    client.global.set("drawId", response.body.id);
    client.log("drawId = " + client.global.get("drawId"));
%}

###---------------------------------------
### GET CREATED DRAW
###---------------------------------------

# @name getCreatedDraw
GET {{host}}/draws/{{drawId}}

###---------------------------------------
### BUY TICKET
###---------------------------------------

# @name buyTicketSuccess
POST {{host}}/draws/{{drawId}}/tickets
Authorization: Bearer {{userToken}}

###

# @name buySecondTicketSameUser
POST {{host}}/draws/{{drawId}}/tickets
Authorization: Bearer {{userToken}}

###

# @name buyTicketByAnotherUser
POST {{host}}/draws/{{drawId}}/tickets
Authorization: Bearer {{user2Token}}

###

# @name buyWithoutAuth
POST {{host}}/draws/{{drawId}}/tickets

###

# @name buyWithWrongToken
POST {{host}}/draws/{{drawId}}/tickets
Authorization: Bearer wrong-token

###---------------------------------------
### MY TICKETS / RESULTS
###---------------------------------------

# @name myTickets
GET {{host}}/me/tickets
Authorization: Bearer {{userToken}}

###

# @name myResultsBeforeDraw
GET {{host}}/me/results
Authorization: Bearer {{userToken}}

###---------------------------------------
### DRAWS LIST
###---------------------------------------

# @name allDraws
GET {{host}}/draws

###

# @name activeDraws
GET {{host}}/draws?status=ACTIVE

###

# @name closedDraws
GET {{host}}/draws?status=CLOSED

###

# @name completedDraws
GET {{host}}/draws?status=COMPLETED

###---------------------------------------
### CLOSE DRAW
###---------------------------------------
### ВАЖНО:
### В текущем коде контроллеров отдельного HTTP endpoint для закрытия тиража не найдено.
### Этот блок - заготовка. Запускать только если вы добавите такой маршрут на бэкенде.

# @name closeDrawPlaceholder
POST {{host}}/admin/draws/{{drawId}}/close
Authorization: Bearer {{adminToken}}

###---------------------------------------
### RUN DRAW
###---------------------------------------
### run-draw существует в текущем AdminDrawController,
### но DrawService требует, чтобы тираж уже был CLOSED.

# @name runDraw
POST {{host}}/admin/draws/{{drawId}}/run-draw
Authorization: Bearer {{adminToken}}

###---------------------------------------
### DRAW RESULT
###---------------------------------------

# @name getDrawResult
GET {{host}}/draws/{{drawId}}/result

###

# @name getDrawAfterRun
GET {{host}}/draws/{{drawId}}

###

# @name myResultsAfterDraw
GET {{host}}/me/results
Authorization: Bearer {{userToken}}