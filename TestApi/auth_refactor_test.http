@host = http://localhost:8080

### ================================================================
### AUTH REFACTOR TEST
### Цель: убедиться что после рефакторинга авторизация работает
### одинаково во всех контроллерах (Ticket, Draw, Admin, User).
### ----------------------------------------------------------------
### Предусловие: приложение запущено, БД проинициализирована,
### пользователи ivan / marck зарегистрированы (см. integration_api_test.http).
### Админ: seed-админ (admin / admin123).
### ================================================================


### ----------------------------------------------------------------
### SETUP — регистрируем юзера (идемпотентно) и получаем токены
### ----------------------------------------------------------------

### Регистрация ivan. Если уже существует — 409, это норма, ассертов нет.
# @name registerUserIdempotent
POST {{host}}/auth/register
Content-Type: application/json

{
  "login": "ivan",
  "password": "87654321"
}

###
# @name loginAdminSetup
POST {{host}}/auth/login
Content-Type: application/json

{
  "login": "admin",
  "password": "admin123"
}

> {%
    client.global.set("adminToken", response.body.token);
    client.test("admin login 200", function () {
        client.assert(response.status === 200, "Expected 200");
    });
%}

###
# @name loginUserSetup
POST {{host}}/auth/login
Content-Type: application/json

{
  "login": "ivan",
  "password": "87654321"
}

> {%
    client.global.set("userToken", response.body.token);
    client.test("user login 200", function () {
        client.assert(response.status === 200, "Expected 200");
    });
%}


### ================================================================
### HAPPY PATH — все защищённые эндпоинты принимают корректный токен
### ================================================================

### USERS -----------------------------------------------------------

# @name meOk
GET {{host}}/users/me
Authorization: Bearer {{userToken}}

> {%
    client.test("GET /users/me → 200", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
%}

### TICKETS ----------------------------------------------------------

###
# @name myTicketsOk
GET {{host}}/me/tickets
Authorization: Bearer {{userToken}}

> {%
    client.test("GET /me/tickets → 200", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
    client.test("GET /me/tickets → array", function () {
        client.assert(Array.isArray(response.body), "Expected array");
    });
%}

###
# @name myResultsOk
GET {{host}}/me/results
Authorization: Bearer {{userToken}}

> {%
    client.test("GET /me/results → 200", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
%}

### ADMIN -----------------------------------------------------------

###
# @name adminPingOk
GET {{host}}/admin/ping
Authorization: Bearer {{adminToken}}

> {%
    client.test("GET /admin/ping with admin → 200", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
%}


### ================================================================
### NEGATIVE — отсутствующий/битый токен возвращает 401 ОДИНАКОВО
### Это ключевое: до рефакторинга TicketController парсил токен сам,
### после — должен вести себя так же, как остальные (через AuthUtil).
### ================================================================

### 1. БЕЗ заголовка Authorization

###
# @name ticketBuyNoAuth
POST {{host}}/draws/1/tickets

> {%
    client.test("POST /draws/1/tickets без токена → 401", function () {
        client.assert(response.status === 401, "Expected 401, got " + response.status);
    });
%}

###
# @name myTicketsNoAuth
GET {{host}}/me/tickets

> {%
    client.test("GET /me/tickets без токена → 401", function () {
        client.assert(response.status === 401, "Expected 401, got " + response.status);
    });
%}

###
# @name myResultsNoAuth
GET {{host}}/me/results

> {%
    client.test("GET /me/results без токена → 401", function () {
        client.assert(response.status === 401, "Expected 401, got " + response.status);
    });
%}

###
# @name meNoAuth
GET {{host}}/users/me

> {%
    client.test("GET /users/me без токена → 401", function () {
        client.assert(response.status === 401, "Expected 401, got " + response.status);
    });
%}

### 2. БИТЫЙ токен (формат правильный, но токена нет в хранилище)

###
# @name ticketBuyBadToken
POST {{host}}/draws/1/tickets
Authorization: Bearer totally-invalid-token

> {%
    client.test("POST /draws/1/tickets битый токен → 401", function () {
        client.assert(response.status === 401, "Expected 401, got " + response.status);
    });
%}

###
# @name myTicketsBadToken
GET {{host}}/me/tickets
Authorization: Bearer totally-invalid-token

> {%
    client.test("GET /me/tickets битый токен → 401", function () {
        client.assert(response.status === 401, "Expected 401, got " + response.status);
    });
%}

###
# @name meBadToken
GET {{host}}/users/me
Authorization: Bearer totally-invalid-token

> {%
    client.test("GET /users/me битый токен → 401", function () {
        client.assert(response.status === 401, "Expected 401, got " + response.status);
    });
%}

### 3. Заголовок без префикса "Bearer "

###
# @name ticketBuyNoBearerPrefix
POST {{host}}/draws/1/tickets
Authorization: {{userToken}}

> {%
    client.test("POST /draws/1/tickets без префикса Bearer → 401", function () {
        client.assert(response.status === 401, "Expected 401, got " + response.status);
    });
%}

###
# @name myTicketsNoBearerPrefix
GET {{host}}/me/tickets
Authorization: {{userToken}}

> {%
    client.test("GET /me/tickets без префикса Bearer → 401", function () {
        client.assert(response.status === 401, "Expected 401, got " + response.status);
    });
%}

### 4. Пустой токен после "Bearer "

###
# @name ticketBuyEmptyToken
POST {{host}}/draws/1/tickets
Authorization: Bearer

> {%
    client.test("POST /draws/1/tickets пустой токен → 401", function () {
        client.assert(response.status === 401, "Expected 401, got " + response.status);
    });
%}


### ================================================================
### FORBIDDEN — роль не ADMIN
### Проверяет что требование роли не сломалось после рефакторинга.
### ================================================================

###
# @name adminPingByUser
GET {{host}}/admin/ping
Authorization: Bearer {{userToken}}

> {%
    client.test("GET /admin/ping под юзером → 403", function () {
        client.assert(response.status === 403, "Expected 403, got " + response.status);
    });
%}

###
# @name adminDrawByUser
POST {{host}}/admin/draws
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "title": "Forbidden Draw",
  "endDate": "2026-04-25T18:00:00+03:00",
  "totalTickets": 3
}

> {%
    client.test("POST /admin/draws под юзером → 403", function () {
        client.assert(response.status === 403, "Expected 403, got " + response.status);
    });
%}
