###---------------------------------------
### MISSED MAIN SCENARIOS
###---------------------------------------

### ---------------------------------------
### REPEATED LOGIN RETURNS THE SAME TOKEN
### ---------------------------------------

# @name loginUser1Again
POST {{host}}/auth/login
Content-Type: application/json

{
  "login": "ivan",
  "password": "87654321"
}

> {%
    client.test("loginUser1Again status is 200", function() {
        client.assert(response.status === 200, "Expected 200");
    });
    client.test("loginUser1Again returns the same token", function() {
        client.assert(response.body.token === client.global.get("user1Token"), "Expected the same token");
    });
%}

