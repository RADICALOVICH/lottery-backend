### ---------------------------------------
### ADMIN LOGIN
### do not forget to assign ADMIN role to the admin user in database
### ---------------------------------------

# @name loginAdmin
POST {{host}}/auth/login
Content-Type: application/json

{
  "login": "admin",
  "password": "admin123"
}

> {%
    client.global.set("adminToken", response.body.token);
    client.log("adminToken = " + client.global.get("adminToken"));
%}

### ---------------------------------------
### LOGIN USER 1
### ---------------------------------------

# @name loginUser1
POST {{host}}/auth/login
Content-Type: application/json

{
  "login": "ivan",
  "password": "87654321"
}

> {%
    client.global.set("user1Token", response.body.token);
    client.log("user1Token = " + client.global.get("user1Token"));
%}


