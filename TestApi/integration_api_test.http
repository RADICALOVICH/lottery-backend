### ---------------------------------------
### USERS / ADMIN BASIC CHECKS
### ---------------------------------------

# @name meUser1Check
GET {{host}}/users/me
Authorization: Bearer {{user1Token}}

> {%
    client.test("meUser1Check status is 200", function() {
        client.assert(response.status === 200, "Expected 200");
    });
    client.test("meUser1Check login is ivan", function() {
        client.assert(response.body.login === "ivan", "Expected login ivan");
    });
%}

###
# @name adminPingCheck
GET {{host}}/admin/ping
Authorization: Bearer {{adminToken}}

> {%
    client.test("adminPingCheck status is 200", function() {
        client.assert(response.status === 200, "Expected 200");
    });
    client.test("adminPingCheck role is ADMIN", function() {
        client.assert(response.body.role === "ADMIN", "Expected ADMIN role");
    });
%}

###
# @name usersListCheck
GET {{host}}/users
Authorization: Bearer {{adminToken}}

> {%
    client.test("usersListCheck status is 200", function() {
        client.assert(response.status === 200, "Expected 200");
    });
    client.test("usersListCheck returns array", function() {
        client.assert(Array.isArray(response.body), "Expected array");
    });
%}

###
# @name loggedInUsersCheck
GET {{host}}/admin/logged-in-users
Authorization: Bearer {{adminToken}}

> {%
    client.test("loggedInUsersCheck status is 200", function() {
        client.assert(response.status === 200, "Expected 200");
    });
    client.test("loggedInUsersCheck returns array", function() {
        client.assert(Array.isArray(response.body), "Expected array");
    });
%}

### ---------------------------------------
### DRAWS / TICKETS BASIC CHECKS
### ---------------------------------------

# @name drawByIdCheck
GET {{host}}/draws/{{drawId}}

> {%
    client.test("drawByIdCheck status is 200", function() {
        client.assert(response.status === 200, "Expected 200");
    });
    client.test("drawByIdCheck id is correct", function() {
        client.assert(String(response.body.id) === String(client.global.get("drawId")), "Unexpected draw id");
    });
%}

### @name draw2ByIdCheck
GET {{host}}/draws/{{draw2Id}}

> {%
    client.test("drawByIdCheck status is 200", function() {
        client.assert(response.status === 200, "Expected 200");
    });
    client.test("drawByIdCheck id is correct", function() {
        client.assert(String(response.body.id) === String(client.global.get("draw2Id")), "Unexpected draw id");
    });
%}

