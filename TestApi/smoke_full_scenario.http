###
### Lottery — Business Scenario Smoke Test (без розыгрыша)
###
### Покрывает happy path до и включая покупку билетов + ключевые негативы.
### Закрытие тиража и run-draw намеренно вынесены за рамки — они требуют либо
### ожидания шедулера (~60s), либо ручного UPDATE через SQL. Прогоняй этот файл
### после каждого батча рефакторинга — все ассерты должны быть зелёными.
###
### Prerequisites:
### - App running on http://localhost:8080
### - DB migration V2__seed_admin.sql применена (создаёт admin / admin123)
###
### Repeatability:
### - Регистрация юзера использует {{$random.alphabetic}} — каждый прогон
###   создаёт нового юзера, БД сбрасывать не нужно.
###

@host = http://localhost:8080

### 1. HEALTH — sanity check
# @name health
GET {{host}}/health

> {%
    client.test("health is UP", () => {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
%}

### 2. ADMIN LOGIN — seeded admin from V2 migration
# @name loginAdmin
POST {{host}}/auth/login
Content-Type: application/json

{
  "login": "admin",
  "password": "admin123"
}

> {%
    client.test("admin login OK", () => {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(response.body.token, "Expected token in body");
        client.assert(response.body.role === "ADMIN", "Expected ADMIN role, got " + response.body.role);
    });
    client.global.set("adminToken", response.body.token);
%}

### 3. REGISTER USER — random suffix so file is rerunnable without DB reset
# @name registerUser
POST {{host}}/auth/register
Content-Type: application/json

{
  "login": "user_{{$random.alphabetic(8)}}",
  "password": "supersecret123"
}

> {%
    client.test("register OK", () => {
        client.assert(response.status === 201, "Expected 201, got " + response.status);
        client.assert(response.body.id, "Expected user id in body");
    });
    client.global.set("userLogin", response.body.login);
%}

### 4. USER LOGIN
# @name loginUser
POST {{host}}/auth/login
Content-Type: application/json

{
  "login": "{{userLogin}}",
  "password": "supersecret123"
}

> {%
    client.test("user login OK", () => {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(response.body.token, "Expected token in body");
        client.assert(response.body.role === "USER", "Expected USER role");
    });
    client.global.set("userToken", response.body.token);
%}

### 5. ADMIN CREATES DRAW
# @name createDraw
POST {{host}}/admin/draws
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "title": "Smoke Test Draw",
  "endDate": "2027-12-31T23:59:00+03:00",
  "totalTickets": 5
}

> {%
    client.test("draw created", () => {
        client.assert(response.status === 201, "Expected 201, got " + response.status);
        client.assert(response.body.id, "Expected draw id");
        client.assert(response.body.status === "ACTIVE", "Expected ACTIVE status");
        client.assert(response.body.totalTickets === 5, "Expected totalTickets === 5");
    });
    client.global.set("drawId", response.body.id);
%}

### 6. ACTIVE DRAWS LIST — наш draw там
# @name getActiveDraws
GET {{host}}/draws?status=ACTIVE

> {%
    client.test("active list contains our draw", () => {
        client.assert(response.status === 200);
        const ids = response.body.map(d => d.id);
        client.assert(
            ids.includes(client.global.get("drawId")),
            "Expected our drawId in ACTIVE list, got " + JSON.stringify(ids)
        );
    });
%}

### 7. USER BUYS TICKET #1
# @name buyTicket1
POST {{host}}/draws/{{drawId}}/tickets
Authorization: Bearer {{userToken}}

> {%
    client.test("ticket bought", () => {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(response.body.ticket, "Expected ticket in response");
        client.assert(response.body.ticket.status === "SOLD", "Expected SOLD, got " + response.body.ticket.status);
        client.assert(response.body.ticket.ownerId !== null, "Expected ownerId set");
    });
%}

### 8. USER BUYS TICKET #2
# @name buyTicket2
POST {{host}}/draws/{{drawId}}/tickets
Authorization: Bearer {{userToken}}

> {%
    client.test("second ticket bought", () => {
        client.assert(response.status === 200);
        client.assert(response.body.ticket.status === "SOLD");
    });
%}

### 9. USER LISTS HIS TICKETS — должно быть 2 в этом тираже
# @name myTickets
GET {{host}}/me/tickets
Authorization: Bearer {{userToken}}

> {%
    client.test("user has 2 tickets in this draw", () => {
        client.assert(response.status === 200);
        const myTicketsInDraw = response.body.filter(t => t.drawId === client.global.get("drawId"));
        client.assert(
            myTicketsInDraw.length === 2,
            "Expected exactly 2 tickets in this draw, got " + myTicketsInDraw.length
        );
    });
%}

### -----------------------------------------------------------------
### NEGATIVE CASES — auth и validation
### -----------------------------------------------------------------

### 10. Buy ticket without token → 401
# @name buyTicketNoAuth
POST {{host}}/draws/{{drawId}}/tickets

> {%
    client.test("no token → 401", () => {
        client.assert(response.status === 401, "Expected 401, got " + response.status);
    });
%}

### 11. Non-admin tries to create draw → 403
# @name createDrawAsUser
POST {{host}}/admin/draws
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "title": "Forbidden",
  "endDate": "2027-12-31T23:59:59+03:00",
  "totalTickets": 1
}

> {%
    client.test("non-admin → 403", () => {
        client.assert(response.status === 403, "Expected 403, got " + response.status);
    });
%}

### 12. Create draw with past endDate → 400 VALIDATION_FAILED
# @name createDrawPastDate
POST {{host}}/admin/draws
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "title": "Past Date",
  "endDate": "2020-01-01T00:00:00Z",
  "totalTickets": 1
}

> {%
    client.test("past endDate → 400 VALIDATION_FAILED", () => {
        client.assert(response.status === 400, "Expected 400, got " + response.status);
        client.assert(response.body.code === "VALIDATION_FAILED", "Expected code VALIDATION_FAILED, got " + response.body.code);
    });
%}

### 13. USER LOGOUT
# @name logoutUser
POST {{host}}/auth/logout
Authorization: Bearer {{userToken}}

> {%
    client.test("logout OK", () => {
        client.assert(response.status === 200);
    });
%}
